rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Projects Validation Blueprint
    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128
          && data.prompt is string && data.prompt.size() <= 20000
          && data.timestamp is string && data.timestamp.size() <= 128
          && data.ownerId is string && data.ownerId.size() <= 128
          && data.files is map;
    }

    // Connectors Validation Blueprint
    function isValidConnectorsConfig(data) {
      return data.selectedModelId is string && data.selectedModelId.size() <= 64
          && data.ownerId is string && data.ownerId.size() <= 128
          && data.connectors is list
          && data.connectors.size() <= 20;
    }

    // Projects Master Gate
    match /projects/{projectId} {
      allow get, delete: if isVerified() 
                         && isValidId(projectId) 
                         && resource.data.ownerId == request.auth.uid;

      allow list: if isVerified() 
                  && resource.data.ownerId == request.auth.uid;

      allow create: if isVerified()
                    && isValidId(projectId)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.id == projectId
                    && isValidProject(request.resource.data);

      allow update: if isVerified()
                    && isValidId(projectId)
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.id == projectId
                    && isValidProject(request.resource.data)
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prompt', 'timestamp', 'files']));
    }

    // Isolated Private User Connectors
    match /users/{userId}/private/connectors {
      allow get, delete: if isVerified() && isOwner(userId);

      allow create: if isVerified() && isOwner(userId)
                    && request.resource.data.ownerId == userId
                    && isValidConnectorsConfig(request.resource.data);

      allow update: if isVerified() && isOwner(userId)
                    && resource.data.ownerId == userId
                    && request.resource.data.ownerId == userId
                    && isValidConnectorsConfig(request.resource.data)
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedModelId', 'connectors']));
    }
  }
}
